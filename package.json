{
  "name": "goldenevents",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"node --env-file-if-exists=.env server/index.js\" \"vite --host 0.0.0.0\"",
    "build": "tsc -b && vite build",
    "start": "NODE_ENV=production node --env-file-if-exists=.env server/index.js",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "test:e2e:serve": "concurrently -k \"NODE_ENV=test PORT=3101 DATA_DIR=./data/e2e PUBLIC_ORIGIN=http://goldencreation.localhost:5181 APP_ORIGIN=http://app.goldencreation.localhost:5181 node server/index.js\" \"API_PORT=3101 vite --host 127.0.0.1 --port 5181 --strictPort\"",
    "check": "npm run build && npm test",
    "admin:create": "node --env-file-if-exists=.env scripts/create-admin.js",
    "backup": "node --env-file-if-exists=.env scripts/backup.js"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.2.8",
    "@zxing/browser": "^0.1.5",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.2",
    "nodemailer": "^10.0.16",
    "qrcode": "^1.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.3",
    "sharp": "^0.35.5",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "vite": "^7.1.9"
  }
}
