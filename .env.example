PUBLIC_ORIGIN=http://goldencreation.localhost:5173
APP_ORIGIN=http://app.goldencreation.localhost:5173
PAYMENT_DRIVER=demo
PAYOUT_DRIVER=demo
PAYOUT_OTP_DRIVER=auto
NEXTSMS_ENABLED=false
NEXTSMS_BASE_URL=https://messaging-service.co.tz
