# one in Flutterwave mode rather than sending an invented customer email.
FLW_SECRET_KEY=
FLW_SECRET_HASH=
ECOFY_BASE_URL=https://ecofypay.ecofy.co.tz
ECOFY_API_KEY=
ECOFY_WEBHOOK_SECRET=
DELIVERY_DRIVER=outbox
