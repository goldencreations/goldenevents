PORT=3001
DATA_DIR=./data
BASE_DOMAIN=goldencreation.localhost
PUBLIC_ORIGIN=http://goldencreation.localhost:5173
APP_ORIGIN=http://app.goldencreation.localhost:5173
PAYMENT_DRIVER=demo
SEED_DEMO=true
DEMO_EMAIL=demo@goldencreation.events
DEMO_PASSWORD=GoldenDemo2026!
# When deploying, set SEED_DEMO=false and PAYMENT_DRIVER=disabled until ready.
# Flutterwave requires an email address for Tanzania charges; checkout requests
# one in Flutterwave mode rather than sending an invented customer email.
FLW_SECRET_KEY=
FLW_SECRET_HASH=
ECOFY_BASE_URL=https://ecofypay.ecofy.co.tz
ECOFY_API_KEY=
ECOFY_WEBHOOK_SECRET=
DELIVERY_DRIVER=outbox
# Meta WhatsApp works independently; other channels can remain in outbox mode.
WHATSAPP_DRIVER=disabled
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_GRAPH_API_VERSION=v25.0
WHATSAPP_TEMPLATE_NAME=golden_event_ticket
WHATSAPP_TEMPLATE_LANGUAGE=en
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Golden Events <tickets@goldencreation.events>
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_CONTENT_SID=
